# 第 48 天：生产环境的配置。复制成 .env.production 再填；这个文件不要提交（.gitignore 已经忽略 .env.*）。
# 密钥也可以不写在文件里，改用云平台的密钥管理注入环境变量。
NODE_ENV=production
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
EMBEDDING_MODEL=
VISION_MODEL=
# openssl rand -base64 48
SESSION_SECRET=
# 第 45 天的任务接口用的 API Key：key:用户,key:用户
SERVICE_API_KEYS=
# docker compose 也会读这个文件里的 POSTGRES_PASSWORD（用 --env-file 指定，见 README）
POSTGRES_PASSWORD=
LOG_LEVEL=info
# 第 50 天：运营
# 管理员的邮箱（逗号分隔），能看 /api/admin/stats；先注册，再重启一次
ADMIN_EMAILS=
# 试用阶段只给拿到邀请码的人注册（逗号分隔）；正式开放时留空
INVITE_CODES=
# canary 标签的 prompt 给多少用户（0–100）
CANARY_PERCENT=0
# 告警发到哪个群机器人
ALERT_WEBHOOK_URL=
# 每个用户每天最多几次、最多花多少钱（元）
DAILY_MAX_REQUESTS=30
DAILY_MAX_COST=1
# 模型单价：输入,缓存命中的输入,输出（元/百万 token）
OPENAI_PRICE=
