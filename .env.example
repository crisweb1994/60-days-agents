# 模型配置。只做离线练习（npm run check <天数>）可以不填；
# 加上 -- --e2e，或者直接运行 Agent 和它对话时才会用到。
#
# 变量名里的 OPENAI 指的是「OpenAI 兼容接口」，不是只能用 OpenAI 的模型。各家的接口地址：
#   DeepSeek       https://api.deepseek.com/v1
#   通义千问       https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM       https://open.bigmodel.cn/api/paas/v4
#   Kimi           https://api.moonshot.cn/v1
#   MiniMax        https://api.minimaxi.com/v1
#   本地 Ollama    http://localhost:11434/v1（API Key 随便填一个非空的值）
# 模型名变化很快，以 docs/models.md 为准。
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# 可选：模型单价，填了以后运行 Agent 会显示每次调用的花费（第 2 天起）。
# 格式是「输入,缓存命中的输入,输出」，单位是元/百万 token，比如 2,0.2,8。以模型服务的价格页为准
OPENAI_PRICE=

# 第 8 天起：Anthropic 兼容接口。多数国产模型服务也提供，API Key 通常和上面的是同一个。各家的接口地址：
#   DeepSeek       https://api.deepseek.com/anthropic
#   通义千问       https://dashscope.aliyuncs.com/apps/anthropic
#   智谱 GLM       https://open.bigmodel.cn/api/anthropic
#   Kimi           https://api.moonshot.cn/anthropic
#   MiniMax        https://api.minimaxi.com/anthropic
#   本地 Ollama    http://localhost:11434（API Key 随便填一个非空的值）
# 客户端会在地址后面加上 /v1/messages。模型名以 docs/models.md 为准。
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# 可选：Anthropic 兼容接口的单价，格式同 OPENAI_PRICE。第 10 天的 mini-agent 切换协议后用它算花费
ANTHROPIC_PRICE=

# 第 12 天起：联网搜索。SEARCH_PROVIDER 选 tavily、bocha 或 brave，再填对应的 Key。不填就不能搜索，但还能读给定的网址。
# 离线测试和 e2e 测试都用本地的假搜索服务，不需要这些 Key；直接运行研究助手时才用到
SEARCH_PROVIDER=
TAVILY_API_KEY=
BOCHA_API_KEY=
BRAVE_API_KEY=

# 第 13 天起：MCP 服务器的配置文件，默认是当前目录的 mcp.json
MCP_CONFIG=

# 第 15 天起：模型的上下文窗口（token），按预算组装上下文时用，默认 64000
CONTEXT_WINDOW=

# 第 17 天起：embedding 模型。地址和 Key 不填时沿用 OPENAI_BASE_URL、OPENAI_API_KEY，模型名必须填。
# 不是每家模型服务都提供 embedding，可以另选一家，或者用本地 Ollama。模型名以 docs/models.md 为准
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 可选：向量的维数，只有支持指定维数的模型才填
EMBEDDING_DIMENSIONS=

# 第 20 天起：研究助手要检索的本地文档目录。不填就不查本地文档
DOCS_DIR=

# 第 22 天起：便宜的模型，用来给问题分类、回答简单的问题。和 OPENAI_* 用同一个服务，只填模型名；不填就用 OPENAI_MODEL
CHEAP_MODEL=
# 可选：便宜的模型的单价，格式同 OPENAI_PRICE。第 36 天比较成本时用，不填就用 OPENAI_PRICE
CHEAP_PRICE=

# 第 33 天起：横评用的第二家模型（OpenAI 兼容接口），第 35 天也用它当备用模型。地址和 Key 不填时沿用 OPENAI_*
ALT_BASE_URL=
ALT_API_KEY=
ALT_MODEL=
# 可选：第二家模型的单价，格式同 OPENAI_PRICE
ALT_PRICE=

# 第 34 天起：Langfuse（自托管或云服务），用来看 trace。不填就不导出，只在终端里打印
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# 第 38 天起：代码沙箱用的 Docker 镜像。不填就用 node:22-alpine 和 python:3.12-slim（要先 docker pull）
SANDBOX_NODE_IMAGE=
SANDBOX_PYTHON_IMAGE=
