{
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["days", "shared", "scripts", "vitest.config.ts"],
  // 第 53 天起的示例仓库是 review-bot 要审查的代码，里面故意留着 bug
  "exclude": ["days/*/data/repo"]
}
