# 第 48 天：生产环境的配置。复制成 .env.production 再填；这个文件不要提交（.gitignore 已经忽略 .env.*）。
# 密钥也可以不写在文件里，改用云平台的密钥管理注入环境变量。
NODE_ENV=production
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
EMBEDDING_MODEL=
VISION_MODEL=
# openssl rand -base64 48
SESSION_SECRET=
# 第 45 天的任务接口用的 API Key：key:用户,key:用户
SERVICE_API_KEYS=
# docker compose 也会读这个文件里的 POSTGRES_PASSWORD（用 --env-file 指定，见 README）
POSTGRES_PASSWORD=
LOG_LEVEL=info
